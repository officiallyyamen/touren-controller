expression Ordner = "C:\Users\yamen\Projekte\touren-controller\daten" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: f9517e89-1a22-5c0a-aa17-906ac3a02cc2

	annotation PBI_ResultType = Text

expression Standortliste =
		let
		    Quelle = Table.PromoteHeaders(Csv.Document(File.Contents(Ordner & "\standorte.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.None]), [PromoteAllScalars = true]),
		    Typen = Table.TransformColumnTypes(Quelle, {{"Kopfzeile", Int64.Type}, {"Diesel_brutto", Int64.Type}}, "de-AT")
		in
		    Typen
	lineageTag: 1b6255ae-e8d9-5fdd-a154-2130978ba652

expression Spaltenliste =
		let
		    Quelle = Table.PromoteHeaders(Csv.Document(File.Contents(Ordner & "\spalten.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.None]), [PromoteAllScalars = true])
		in
		    Quelle
	lineageTag: 541937f5-c566-5ec8-a97d-330792f25ec9

expression fnDatum =
		(x as any) as nullable date =>
		    let
		        Wert = try
		            if x is datetime or x is date then Date.From(x)
		            else if x is number then Date.From(x)
		            else if x is text then Date.FromText(x, [Format = "dd.MM.yyyy", Culture = "de-AT"])
		            else null
		        otherwise null
		    in
		        Wert
	lineageTag: dfeefe45-91b7-5dbd-a44c-747c1c24a525

expression fnZahl =
		(x as any) as nullable number =>
		    if x = null then null
		    else if x is number then x
		    else if Text.Contains(x, ":") then
		        Number.From(Text.BeforeDelimiter(x, ":")) + Number.From(Text.AfterDelimiter(x, ":")) / 60
		    else Number.FromText(Text.Select(x, {"0".."9", ",", ".", "-"}), "de-AT")
	lineageTag: 51485f55-e814-5189-8f9d-e77e68b98ae0

expression fnTour =
		(kuerzel as text, x as any) as nullable text =>
		    if x = null then null
		    else kuerzel & "-" & Text.PadStart(Text.Select(Text.From(x), {"0".."9"}), 2, "0")
	lineageTag: 95508a7c-4ee8-582c-a0d6-e10e7d173038

expression fnStandort =
		(kuerzel as text, datei as text, kopfzeile as number, brutto as number) as table =>
		    let
		        Mappe = Excel.Workbook(File.Contents(Ordner & "\standorte\" & datei), null, true),
		        Blaetter = Table.SelectRows(Mappe, each [Kind] = "Sheet")[Data],
		        Namen = Table.ToRows(Table.SelectColumns(Table.SelectRows(Spaltenliste, each [Kuerzel] = kuerzel), {"Alt", "Neu"})),
		        Lies = (blatt as table) =>
		            let
		                OhneTitel = Table.Skip(blatt, kopfzeile),
		                MitKopf = Table.PromoteHeaders(OhneTitel, [PromoteAllScalars = true]),
		                Einheitlich = Table.RenameColumns(MitKopf, Namen)
		            in
		                Table.SelectColumns(Einheitlich, {"Datum", "Tour", "Fahrzeug", "km", "Stunden", "Diesel"}),
		        Alle = Table.Combine(List.Transform(Blaetter, Lies)),
		        Werte = Table.TransformColumns(Alle, {
		            {"Datum", fnDatum, type nullable date},
		            {"Tour", each fnTour(kuerzel, _), type nullable text},
		            {"Fahrzeug", each if _ = null then null else Text.From(_), type nullable text},
		            {"km", fnZahl, type nullable number},
		            {"Stunden", fnZahl, type nullable number},
		            {"Diesel", each if _ = null then null else fnZahl(_) / (if brutto = 1 then 1.2 else 1), type nullable number}
		        }),
		        OhneSummen = Table.SelectRows(Werte, each [Datum] <> null and [Tour] <> null)
		    in
		        Table.AddColumn(OhneSummen, "Standort", each kuerzel, type text)
	lineageTag: af596d71-0cd9-5c36-ba9f-f4914a3a98cc

expression WaageRoh =
		let
		    Dateien = Table.SelectRows(Folder.Files(Ordner & "\wiegescheine"), each [Extension] = ".csv"),
		    Lies = (inhalt as binary) => Table.PromoteHeaders(Csv.Document(inhalt, [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.None]), [PromoteAllScalars = true]),
		    Alle = Table.Combine(List.Transform(Dateien[Content], Lies)),
		    Typen = Table.TransformColumnTypes(Table.ReplaceValue(Alle, "", null, Replacer.ReplaceValue, {"Netto_kg"}), {{"Datum", type date}, {"Netto_kg", type number}}, "de-AT")
		in
		    Typen
	lineageTag: 6ed80ab8-48e7-538d-bab9-b1e557e07f82

expression Waage =
		let
		    Eindeutig = Table.Distinct(WaageRoh, {"Schein"}),
		    Summe = Table.Group(Eindeutig, {"Tour", "Datum"}, {{"kg", each List.Sum([Netto_kg]), type nullable number}})
		in
		    Summe
	lineageTag: 11f3b623-ba13-5b83-956d-dd85e3c68786

expression Preise =
		let
		    Quelle = Table.PromoteHeaders(Csv.Document(File.Contents(Ordner & "\vertraege.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.None]), [PromoteAllScalars = true]),
		    Typen = Table.TransformColumnTypes(Quelle, {{"Kapazitaet_t", type number}, {"Preis_Abfuhr", type number}, {"Gueltig_ab", type date}}, "de-AT")
		in
		    Typen
	lineageTag: 28c8f9d2-2ed2-50a8-af44-50483a37afde

