		lineageTag: 9c85870a-721d-5265-85aa-2bfe501832cc
		summarizeBy: sum
		sourceColumn: Erloes

	partition Fahrten = m
		mode: import
		source =
				let
				    JeStandort = Table.AddColumn(Standortliste, "Daten", each fnStandort([Kuerzel], [Datei], [Kopfzeile], [Diesel_brutto])),
				    Alle = Table.Combine(JeStandort[Daten]),
				    MitGewicht = Table.ExpandTableColumn(Table.NestedJoin(Alle, {"Tour", "Datum"}, Waage, {"Tour", "Datum"}, "w", JoinKind.LeftOuter), "w", {"kg"}),
				    Tonnen = Table.AddColumn(MitGewicht, "Tonnen", each if [kg] = null then 0 else [kg] / 1000, type number),
				    MitArt = Table.ExpandTableColumn(Table.NestedJoin(Tonnen, {"Tour"}, Touren, {"Tour"}, "t", JoinKind.LeftOuter), "t", {"Abfallart"}),
				    MitSatz = Table.ExpandTableColumn(Table.NestedJoin(MitArt, {"Abfallart"}, Abfallarten, {"Abfallart"}, "a", JoinKind.LeftOuter), "a", {"Entsorgung_je_t"}),
				    Personal = Table.AddColumn(MitSatz, "Personal", each [Stunden] * Stundensatz, type number),
				    Entsorgung = Table.AddColumn(Personal, "Entsorgung", each [Tonnen] * [Entsorgung_je_t], type number),
				    MitPreisen = Table.NestedJoin(Entsorgung, {"Tour"}, Preise, {"Tour"}, "p", JoinKind.LeftOuter),
				    Erloes = Table.AddColumn(MitPreisen, "Erloes", (z) => Table.Last(Table.Sort(Table.SelectRows(z[p], each [Gueltig_ab] <= z[Datum]), {"Gueltig_ab", Order.Ascending}))[Preis_Abfuhr], type number),
				    Auswahl = Table.SelectColumns(Erloes, {"Datum", "Tour", "Standort", "Fahrzeug", "km", "Stunden", "Diesel", "Tonnen", "Personal", "Entsorgung", "Erloes"})
				in
				    Auswahl

	annotation PBI_ResultType = Table

